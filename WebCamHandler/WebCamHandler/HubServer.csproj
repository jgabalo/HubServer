<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebCamHandler</RootNamespace>
    <AssemblyName>WebCamHandler</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hub payloads are JSON strings parsed with Newtonsoft.Json; kept to preserve the
         case-insensitive parsing and PascalCase output that existing clients rely on. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TradeFeed\TradeFeed.Contracts\TradeFeed.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HubServer.Tests" />
  </ItemGroup>

</Project>
